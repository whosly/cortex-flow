{
  "execution": {
    "max_workers": 4,
    "default_timeout": 30000,
    "max_retries": 3,
    "retry_interval_ms": 1000
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "strategy": {
    "default_type": "Dag"
  },
  "observability": {
    "tracing": true,
    "metrics": true,
    "tracing_sample_rate": 1.0
  }
}
